// Colored translucent cascaded shadow maps (custom addition for UE 4.27.2).
// Full screen pass: atlas (RGB transmittance + farthest translucent depth) -> screen space RGB tint for opaque receivers.

#include "Common.ush"
#include "DeferredShadingCommon.ush"

Texture2D AtlasTexture;       // RGB colored transmittance
Texture2D DepthAtlasTexture;  // R: farthest translucent depth (32 bit)
int NumCascades;
float Strength;
int DebugMode;
float4x4 ScreenToShadow[4];
float4 CellRect[4];     // x, y, width, height in atlas pixels
float4 SplitParams[4];  // SplitNear, SplitFar, FadePlaneOffset, InvFadePlaneLength
float4 DepthParams[4];  // normalized depth bias, inverse normalized transition length

// Manually filtered lookup: every bilinear tap does its own depth test, so depth never bleeds across silhouettes.
float3 SampleColoredShadow(int Cascade, float2 CellUV, float ReceiverZ)
{
	// Outside of the cascade: no information, no tint.
	if (any(CellUV < 0.0f) || any(CellUV > 1.0f))
	{
		return 1.0f;
	}

	const float4 Cell = CellRect[Cascade];
	const float Bias = DepthParams[Cascade].x;
	const float InvTransition = DepthParams[Cascade].y;

	const float2 TexelPos = CellUV * Cell.zw - 0.5f;
	const float2 Base = floor(TexelPos);
	const float2 Frac = TexelPos - Base;

	float3 Result = 0;

	UNROLL
	for (int Y = 0; Y < 2; Y++)
	{
		UNROLL
		for (int X = 0; X < 2; X++)
		{
			const float2 Texel = clamp(Base + float2(X, Y), 0.0f, Cell.zw - 1.0f);
			const int3 LoadPos = int3(int2(Cell.xy + Texel), 0);
			const float4 Sample = AtlasTexture.Load(LoadPos);
			const float FarthestCasterDepth = DepthAtlasTexture.Load(LoadPos).r;

			// Only apply the aggregate tint when the receiver is behind every translucent caster in this texel.
			// This conservative bound prevents surfaces behind the receiver from incorrectly tinting it.
			const float Behind = saturate((ReceiverZ - FarthestCasterDepth - Bias) * InvTransition);
			const float3 Tint = lerp(1.0f, Sample.rgb, Behind);

			const float Weight = (X == 0 ? 1.0f - Frac.x : Frac.x) * (Y == 0 ? 1.0f - Frac.y : Frac.y);
			Result += Tint * Weight;
		}
	}

	return Result;
}

float3 EvaluateCascade(int Cascade, float4 ScreenPosition)
{
	float4 ShadowPosition = mul(ScreenPosition, ScreenToShadow[Cascade]);
	const float ShadowZ = ShadowPosition.z;
	ShadowPosition.xyz /= ShadowPosition.w;
	return SampleColoredShadow(Cascade, ShadowPosition.xy, ShadowZ);
}

// Debug helper: raw atlas sample that the given cascade would use for this pixel.
void DebugCascadeSample(int Cascade, float4 ScreenPosition, out float ReceiverZ, out float2 UV, out float FarthestCasterDepth)
{
	float4 ShadowPosition = mul(ScreenPosition, ScreenToShadow[Cascade]);
	ReceiverZ = ShadowPosition.z;
	ShadowPosition.xyz /= ShadowPosition.w;
	UV = ShadowPosition.xy;

	const float4 Cell = CellRect[Cascade];
	const float2 Texel = clamp(floor(UV * Cell.zw), 0.0f, Cell.zw - 1.0f);
	FarthestCasterDepth = DepthAtlasTexture.Load(int3(int2(Cell.xy + Texel), 0)).r;
}

void TintMainPS(
	in float4 SVPos : SV_POSITION,
	out float4 OutColor : SV_Target0)
{
	const float2 ScreenUV = float2(SVPos.xy * View.BufferSizeAndInvSize.zw);
	const float SceneW = CalcSceneDepth(ScreenUV);
	const float4 ScreenPosition = float4(((ScreenUV.xy - View.ScreenPositionScaleBias.wz) / View.ScreenPositionScaleBias.xy) * SceneW, SceneW, 1);

	float3 Tint = 1.0f;
	bool bCovered = false;
	int UsedCascade = -1;

	// Cascades are sorted from near to far: the first one whose far plane lies behind the pixel owns it.
	LOOP
	for (int Cascade = 0; Cascade < NumCascades; Cascade++)
	{
		if (SceneW < SplitParams[Cascade].y)
		{
			bCovered = true;
			UsedCascade = Cascade;
			const float3 Tint0 = EvaluateCascade(Cascade, ScreenPosition);

			// Inside the fade region of the cascade, blend towards the next one (or towards "no tint" after the last colored cascade).
			const float InvFadeLength = SplitParams[Cascade].w;
			const float Blend = InvFadeLength > 0.0f ? 1.0f - saturate((SceneW - SplitParams[Cascade].z) * InvFadeLength) : 1.0f;

			if (Blend < 1.0f)
			{
				const float3 Tint1 = (Cascade + 1 < NumCascades) ? EvaluateCascade(Cascade + 1, ScreenPosition) : 1.0f;
				Tint = lerp(Tint1, Tint0, Blend);
			}
			else
			{
				Tint = Tint0;
			}
			break;
		}
	}

	OutColor = float4(lerp(1.0f, Tint, Strength), 1.0f);

	if (DebugMode == 2)
	{
		// Screen pass test: magenta where a colored cascade covers the pixel.
		OutColor = float4(bCovered ? float3(1, 0, 1) : float3(1, 1, 1), 1);
	}
	else if (DebugMode >= 4 && DebugMode <= 6)
	{
		OutColor = float4(0, 0, 0, 1);
		if (UsedCascade >= 0)
		{
			float ReceiverZ;
			float2 UV;
			float CasterDepth;
			DebugCascadeSample(UsedCascade, ScreenPosition, ReceiverZ, UV, CasterDepth);
			const bool bOutside = any(UV < 0.0f) || any(UV > 1.0f);
			const bool bHasCaster = CasterDepth > 1e-6f;

			if (DebugMode == 4)
			{
				// Cascade used by this pixel: 0 = red, 1 = green, 2 = blue, 3 = white. Darker = the lookup falls outside the cascade cell.
				const float3 CascadeColor = UsedCascade == 0 ? float3(1, 0, 0) : (UsedCascade == 1 ? float3(0, 1, 0) : (UsedCascade == 2 ? float3(0, 0, 1) : float3(1, 1, 1)));
				OutColor = float4(CascadeColor * (bOutside ? 0.25f : 1.0f), 1);
			}
			else if (DebugMode == 5)
			{
				// Red: a translucent caster exists in the atlas at this pixel's xy. Green: and the receiver is behind it. Blue: lookup outside the cell.
				OutColor = float4(bHasCaster ? 1.0f : 0.0f, (bHasCaster && ReceiverZ > CasterDepth) ? 1.0f : 0.0f, bOutside ? 1.0f : 0.0f, 1);
			}
			else
			{
				// Raw depths: red = receiver depth, green = caster depth (0 where none), both clamped to 0..1.
				OutColor = float4(saturate(ReceiverZ), bHasCaster ? saturate(CasterDepth) : 0.0f, 0, 1);
			}
		}
	}
	else if (DebugMode == 3)
	{
		// Caster map / depth test: red = amount of light removed by translucent casters (amplified x4).
		OutColor = float4(1.0f, 1.0f - saturate(4.0f * (1.0f - dot(Tint, 1.0f / 3.0f))), 1.0f - saturate(4.0f * (1.0f - dot(Tint, 1.0f / 3.0f))), 1);
	}
}
