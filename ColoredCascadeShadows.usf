// Colored translucent cascaded shadow maps (UE 4.27.2).
// One native-resolution cascade is evaluated per fullscreen pass. Passes accumulate far-to-near.

#include "Common.ush"
#include "DeferredShadingCommon.ush"

Texture2D PreviousTintTexture;
Texture2D CascadeColorTexture;
Texture2D CascadeDepthTexture;
float4x4 ScreenToShadow;
float4 SplitParams; // SplitNear, SplitFar, FadePlaneOffset, InvFadePlaneLength
float TransitionScale; // Same transition scale used by native ManualPCF
float Strength;
int DebugMode;

float3 SampleColoredShadow(float2 CascadeUV, float ReceiverZ)
{
	if (any(CascadeUV < 0.0f) || any(CascadeUV > 1.0f)) return 1.0f;
	uint Width, Height;
	CascadeColorTexture.GetDimensions(Width, Height);
	const float2 TexelPos = CascadeUV * float2(Width, Height) - 0.5f;
	const float2 Base = floor(TexelPos);
	const float2 Frac = TexelPos - Base;
	float3 Result = 0.0f;
	UNROLL
	for (int Y = 0; Y < 2; ++Y)
	{
		UNROLL
		for (int X = 0; X < 2; ++X)
		{
			const float2 Texel = clamp(Base + float2(X, Y), 0.0f, float2(Width - 1, Height - 1));
			const int3 LoadPos = int3(int2(Texel), 0);
			const float3 Transmittance = CascadeColorTexture.Load(LoadPos).rgb;
			const float FarthestCasterDepth = CascadeDepthTexture.Load(LoadPos).r;
			const float NativeShadowVisibility = saturate((FarthestCasterDepth - ReceiverZ) * TransitionScale + 1.0f);
			const float Behind = 1.0f - NativeShadowVisibility;
			const float3 Tinted = lerp(1.0f, Transmittance, Behind);
			const float Weight = (X == 0 ? 1.0f - Frac.x : Frac.x) * (Y == 0 ? 1.0f - Frac.y : Frac.y);
			Result += Tinted * Weight;
		}
	}
	return Result;
}

void TintMainPS(in float4 SVPos : SV_POSITION, out float4 OutColor : SV_Target0)
{
	const int2 PixelPos = int2(SVPos.xy);
	const float3 PreviousTint = PreviousTintTexture.Load(int3(PixelPos, 0)).rgb;
	const float2 ScreenUV = SVPos.xy * View.BufferSizeAndInvSize.zw;
	const float SceneW = CalcSceneDepth(ScreenUV);
	const float4 ScreenPosition = float4(
		((ScreenUV - View.ScreenPositionScaleBias.wz) / View.ScreenPositionScaleBias.xy) * SceneW,
		SceneW, 1.0f);

	float3 Result = PreviousTint;
	const bool bInCascade = SceneW >= SplitParams.x && SceneW < SplitParams.y;
	if (bInCascade)
	{
		float4 ShadowPosition = mul(ScreenPosition, ScreenToShadow);
		const float SafeW = (ShadowPosition.w < 0.0f ? -1.0f : 1.0f) * max(abs(ShadowPosition.w), 1e-8f);
		ShadowPosition.xyz /= SafeW;
		const float3 CascadeTint = SampleColoredShadow(ShadowPosition.xy, ShadowPosition.z);
		const float Blend = SplitParams.w > 0.0f
			? 1.0f - saturate((SceneW - SplitParams.z) * SplitParams.w)
			: 1.0f;
		Result = lerp(PreviousTint, lerp(1.0f, CascadeTint, Strength), Blend);
	}
	OutColor = float4(Result, 1.0f);
	if (DebugMode == 2) OutColor = float4(bInCascade ? float3(1, 0, 1) : PreviousTint, 1.0f);
	else if (DebugMode == 3) OutColor = float4(1.0f - Result, 1.0f);
}
