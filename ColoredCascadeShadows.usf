// Colored translucent cascaded shadow maps (UE 4.27.2).
// One native-resolution cascade is evaluated per fullscreen pass. Passes accumulate far-to-near.

#include "Common.ush"
#include "DeferredShadingCommon.ush"

Texture2D PreviousTintTexture;
Texture2D CascadeColorTexture;
Texture2D CascadeDepthTexture;
float4x4 ScreenToShadow;
float InvDepthTransition;
float4 SplitParams; // SplitNear, SplitFar, FadePlaneOffset, InvFadePlaneLength
float Strength;
int DebugMode;
int CascadeIndex;

float3 SampleColoredShadow(float2 CascadeUV, float ReceiverZ)
{
	// The receiver depth is already normalized by the native screen-to-shadow matrix.
	// Reject pixels outside the valid directional shadow depth interval instead of
	// allowing invalid receiver positions to sample a clamped edge texel.
	if (any(CascadeUV < 0.0f) || any(CascadeUV > 1.0f) ||
		ReceiverZ < 0.0f || ReceiverZ >= 0.99999f)
	{
		return 1.0f;
	}

	uint Width, Height;
	CascadeColorTexture.GetDimensions(Width, Height);

	// Match UE's non-Gather high-quality CSM PCF path:
	// 7x7 point samples are shared by four overlapping 3x3 PCF evaluations.
	const float2 TexelPosition = CascadeUV * float2(Width, Height);
	const float2 Fraction = frac(TexelPosition);
	const float2 FirstTexel = floor(TexelPosition) - 3.0f;

	float3 Samples[49];

	// Compare depth per texel before filtering, just like CalculateOcclusion() in UE.
	[unroll]
	for (int Y = 0; Y < 7; ++Y)
	{
		[unroll]
		for (int X = 0; X < 7; ++X)
		{
			const float2 Texel = clamp(FirstTexel + float2(X, Y), 0.0f, float2(Width - 1, Height - 1));
			const int3 LoadPosition = int3(int2(Texel), 0);
			const float3 Transmittance = CascadeColorTexture.Load(LoadPosition).rgb;
			const float CasterDepth = CascadeDepthTexture.Load(LoadPosition).r;
			const float DepthFactor = saturate((ReceiverZ - CasterDepth) * InvDepthTransition);
			// Smooth the existing cascade-scaled depth transition without using fwidth,
			// which can expand the transition across sloped receiver surfaces.
			const float Behind = smoothstep(0.0f, 1.0f, DepthFactor);
			Samples[Y * 7 + X] = lerp(1.0f, Transmittance, Behind);
		}
	}

	// Each 3x3 PCF result averages nine bilinear comparisons. Four overlapping
	// windows reproduce UE's 6x6 PCF footprint using the shared 7x7 texel grid.
	float3 Result = 0.0f;
	[unroll]
	for (int WindowY = 0; WindowY < 2; ++WindowY)
	{
		[unroll]
		for (int WindowX = 0; WindowX < 2; ++WindowX)
		{
			float3 WindowResult = 0.0f;
			[unroll]
			for (int Y = 0; Y < 3; ++Y)
			{
				[unroll]
				for (int X = 0; X < 3; ++X)
				{
					const int SX = WindowX + X;
					const int SY = WindowY + Y;
					const float3 Top = lerp(
						Samples[SY * 7 + SX],
						Samples[SY * 7 + SX + 1],
						Fraction.x);
					const float3 Bottom = lerp(
						Samples[(SY + 1) * 7 + SX],
						Samples[(SY + 1) * 7 + SX + 1],
						Fraction.x);
					WindowResult += lerp(Top, Bottom, Fraction.y);
				}
			}
			Result += WindowResult * (1.0f / 36.0f);
		}
	}
	return saturate(Result);
}

void TintMainPS(in float4 SVPos : SV_POSITION, out float4 OutColor : SV_Target0)
{
	const int2 PixelPos = int2(SVPos.xy);
	const float3 PreviousTint = PreviousTintTexture.Load(int3(PixelPos, 0)).rgb;
	const float2 ScreenUV = SVPos.xy * View.BufferSizeAndInvSize.zw;
	const float SceneW = CalcSceneDepth(ScreenUV);
	const float4 ScreenPosition = float4(
		((ScreenUV - View.ScreenPositionScaleBias.wz) / View.ScreenPositionScaleBias.xy) * SceneW,
		SceneW, 1.0f);

	float3 Result = PreviousTint;
	const bool bInCascade = SceneW >= SplitParams.x && SceneW < SplitParams.y;
	float2 CascadeUV = 0.0f;
	float ReceiverDepth = 0.0f;
	float CasterDepth = 0.0f;
	float3 CasterTransmittance = 1.0f;
	bool bOutsideCascade = false;
	bool bHasCaster = false;

	if (bInCascade)
	{
		float4 ShadowPosition = mul(ScreenPosition, ScreenToShadow);

		// Receiver depth stays in homogeneous light-space Z, matching the native
		// screen-to-shadow transform. Only XY is divided by W to form texture UVs.
		ReceiverDepth = ShadowPosition.z;
		// Directional CSMs are orthographic, so the native transform provides
		// normalized light-space Z directly (the engine does not divide Z by W).
		// W is still validated before using XY to form cascade UVs.
		const bool bValidShadowW = ShadowPosition.w > 1e-8f;
		const float SafeW = max(ShadowPosition.w, 1e-8f);
		CascadeUV = ShadowPosition.xy / SafeW;
		bOutsideCascade = !bValidShadowW ||
			any(CascadeUV < 0.0f) || any(CascadeUV > 1.0f) ||
			ReceiverDepth < 0.0f || ReceiverDepth >= 0.99999f;

		if (!bOutsideCascade)
		{
			uint Width, Height;
			CascadeDepthTexture.GetDimensions(Width, Height);
			const int2 LastPixel = int2(Width - 1, Height - 1);
			const int2 CasterPixel = clamp(int2(CascadeUV * float2(Width, Height)), int2(0, 0), LastPixel);
			const int3 LoadPosition = int3(CasterPixel, 0);
			CasterDepth = CascadeDepthTexture.Load(LoadPosition).r;
			CasterTransmittance = CascadeColorTexture.Load(LoadPosition).rgb;
			// The depth target clears to 1 and accumulates the nearest translucent
			// surface with MIN. Values below 1 identify populated texels.
			bHasCaster = CasterDepth < (1.0f - 1e-8f);
		}

		const float3 CascadeTint = SampleColoredShadow(CascadeUV, ReceiverDepth);
		const float Blend = SplitParams.w > 0.0f
			? 1.0f - saturate((SceneW - SplitParams.z) * SplitParams.w)
			: 1.0f;
		Result = lerp(PreviousTint, lerp(1.0f, CascadeTint, Strength), Blend);
	}

	OutColor = float4(Result, 1.0f);
	if (DebugMode == 2)
	{
		OutColor = float4(bInCascade ? float3(1, 0, 1) : PreviousTint, 1.0f);
	}
	else if (DebugMode == 3)
	{
		OutColor = float4(1.0f - Result, 1.0f);
	}
	else if (DebugMode == 4 && bInCascade)
	{
		float3 CascadeDebugColor = float3(1.0f, 1.0f, 1.0f);
		if (CascadeIndex == 0) CascadeDebugColor = float3(1.0f, 0.0f, 0.0f);
		else if (CascadeIndex == 1) CascadeDebugColor = float3(0.0f, 1.0f, 0.0f);
		else if (CascadeIndex == 2) CascadeDebugColor = float3(0.0f, 0.0f, 1.0f);
		OutColor = float4(CascadeDebugColor * (bOutsideCascade ? 0.25f : 1.0f), 1.0f);
	}
	else if (DebugMode == 5 && bInCascade)
	{
		OutColor = float4(
			bHasCaster ? 1.0f : 0.0f,
			(bHasCaster && ReceiverDepth > CasterDepth) ? 1.0f : 0.0f,
			bOutsideCascade ? 1.0f : 0.0f,
			1.0f);
	}
	else if (DebugMode == 6 && bInCascade)
	{
		OutColor = float4(saturate(ReceiverDepth), bHasCaster ? saturate(CasterDepth) : 0.0f, 0.0f, 1.0f);
	}
	else if (DebugMode == 7 && bInCascade)
	{
		const float DepthFactor = bHasCaster
			? saturate((ReceiverDepth - CasterDepth) * InvDepthTransition)
			: 0.0f;
		const float Behind = smoothstep(0.0f, 1.0f, DepthFactor);
		const float TintAmount = bHasCaster
			? saturate(4.0f * (1.0f - dot(CasterTransmittance, float3(1.0f / 3.0f, 1.0f / 3.0f, 1.0f / 3.0f))))
			: 0.0f;
		OutColor = float4(Behind, TintAmount, bHasCaster ? 1.0f : 0.0f, 1.0f);
	}
}
