+	/**
+	 * Gathers static-mesh batches that can be expanded from CPU LOD data.
+	 * This only collects candidates; source batches still use their original VF
+	 * and must never be passed directly to the capture processor.
+	 */
+	void GatherSoftwareRTStaticMeshCaptureCandidates(
+		const FScene* Scene,
+		const FSceneView& View,
+		TArray<FSoftwareRTStaticMeshCaptureCandidate>& OutCandidates)
+	{
+		check(IsInRenderingThread());
+		check(Scene);
+		OutCandidates.Reset();
+
+		for (int32 PrimitiveIndex = 0; PrimitiveIndex < Scene->Primitives.Num(); ++PrimitiveIndex)
+		{
+			FPrimitiveSceneInfo* PrimitiveSceneInfo = Scene->Primitives[PrimitiveIndex];
+			if (PrimitiveSceneInfo == nullptr || PrimitiveSceneInfo->Proxy == nullptr)
+			{
+				continue;
+			}
+
+			const FPrimitiveSceneProxy* Proxy = PrimitiveSceneInfo->Proxy;
+			if (Proxy->GetTypeHash() != FStaticMeshSceneProxy::GetStaticMeshSceneProxyTypeHash())
+			{
+				continue;
+			}
+			const FStaticMeshSceneProxy* StaticMeshProxy = static_cast<const FStaticMeshSceneProxy*>(Proxy);
+			const FStaticMeshRenderData* RenderData = StaticMeshProxy->GetSoftwareRTCaptureRenderData();
+			if (RenderData == nullptr || RenderData->LODResources.Num() == 0)
+			{
+				continue;
+			}
+
+			const int32 LODIndex = Proxy->GetLOD(&View);
+			if (!RenderData->LODResources.IsValidIndex(LODIndex)
+				|| LODIndex < RenderData->CurrentFirstLODIdx)
+			{
+				continue;
+			}
+
+			const FStaticMeshLODResources& LODResource = RenderData->LODResources[LODIndex];
+			const FPositionVertexBuffer& PositionBuffer = LODResource.VertexBuffers.PositionVertexBuffer;
+			FStaticMeshVertexBuffer& StaticVertexBuffer =
+				const_cast<FStaticMeshVertexBuffer&>(LODResource.VertexBuffers.StaticMeshVertexBuffer);
+			const FColorVertexBuffer& ColorBuffer = LODResource.VertexBuffers.ColorVertexBuffer;
+
+			// Cooked meshes without CPU-readable position, tangent/UV, or index
+			// data are skipped instead of dereferencing discarded bulk data.
+			if (PositionBuffer.GetVertexData() == nullptr
+				|| !StaticVertexBuffer.GetAllowCPUAccess()
+				|| !LODResource.IndexBuffer.GetNeedsCPUAccess()
+				|| StaticVertexBuffer.GetNumTexCoords() > 4
+				|| (ColorBuffer.GetNumVertices() > 0 && ColorBuffer.GetVertexData() == nullptr)
+				|| (ColorBuffer.GetNumVertices() > 0 && ColorBuffer.GetNumVertices() != PositionBuffer.GetNumVertices()))
+			{
+				continue;
+			}
+
+			const FIndexArrayView IndexArray = LODResource.IndexBuffer.GetArrayView();
+			if (IndexArray.Num() == 0)
+			{
+				continue;
+			}
+
+			for (int32 MeshIndex = 0; MeshIndex < PrimitiveSceneInfo->StaticMeshes.Num(); ++MeshIndex)
+			{
+				const FStaticMeshBatch& MeshBatch = PrimitiveSceneInfo->StaticMeshes[MeshIndex];
+				if (MeshBatch.LODIndex != LODIndex
+					|| MeshBatch.Type != PT_TriangleList
+					|| MeshBatch.MaterialRenderProxy == nullptr
+					|| MeshBatch.Elements.Num() != 1
+					|| MeshBatch.bDitheredLODTransition)
+				{
+					continue;
+				}
+
+				const FMeshBatchElement& Element = MeshBatch.Elements[0];
+				if (Element.IndexBuffer != &LODResource.IndexBuffer
+					|| Element.NumPrimitives == 0
+					|| Element.NumInstances != 1
+					|| Element.bIsInstanceRuns
+					|| Element.bIsSplineProxy
+					|| Element.UserData != nullptr
+					|| Element.VertexFactoryUserData != nullptr
+					|| Element.bUserDataIsColorVertexBuffer)
+				{
+					continue;
+				}
+
+				const uint64 EndIndex = uint64(Element.FirstIndex) + uint64(Element.NumPrimitives) * 3ull;
+				if (EndIndex > uint64(IndexArray.Num()))
+				{
+					continue;
+				}
+
+				const FMaterialRenderProxy* FallbackMaterialRenderProxy = nullptr;
+				const FMaterial& Material = MeshBatch.MaterialRenderProxy->GetMaterialWithFallback(
+					View.GetFeatureLevel(),
+					FallbackMaterialRenderProxy);
+				if (FallbackMaterialRenderProxy != nullptr || !Material.IsUsedWithSoftwareRTCapture())
+				{
+					continue;
+				}
+
+				FSoftwareRTStaticMeshCaptureCandidate& Candidate = OutCandidates.AddDefaulted_GetRef();
+				Candidate.MeshBatch = &MeshBatch;
+				Candidate.PrimitiveSceneInfo = PrimitiveSceneInfo;
+				Candidate.LODResource = TRefCountPtr<FStaticMeshLODResources>(
+					const_cast<FStaticMeshLODResources*>(&LODResource));
+				Candidate.PrimitiveIndex = PrimitiveIndex;
+				Candidate.MeshIndex = MeshIndex;
+				Candidate.LODIndex = LODIndex;
+			}
+		}
+	}
+
 }
