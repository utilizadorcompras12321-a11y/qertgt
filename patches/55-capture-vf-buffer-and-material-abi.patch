+// Copyright Epic Games, Inc. All Rights Reserved.
+
+#include "SoftwareRTCaptureVertexFactory.h"
+#include "MaterialShared.h"
+#include "RHI.h"
+
+// No additional uniform parameters are required: all capture attributes are
+// carried by the expanded vertex stream.
+class FSoftwareRTCaptureVertexFactoryShaderParameters : public FVertexFactoryShaderParameters
+{
+	DECLARE_INLINE_TYPE_LAYOUT(FSoftwareRTCaptureVertexFactoryShaderParameters, NonVirtual);
+};
+
+IMPLEMENT_VERTEX_FACTORY_PARAMETER_TYPE(
+	FSoftwareRTCaptureVertexFactory,
+	SF_Vertex,
+	FSoftwareRTCaptureVertexFactoryShaderParameters);
+
+void FSoftwareRTCaptureVertexFactory::SetData(const FVertexBuffer* InVertexBuffer)
+{
+	check(IsInRenderingThread());
+	check(InVertexBuffer);
+	check(InVertexBuffer->IsInitialized());
+
+	VertexBuffer = InVertexBuffer;
+	UpdateRHI();
+}
+
+bool FSoftwareRTCaptureVertexFactory::ShouldCompilePermutation(
+	const FVertexFactoryShaderPermutationParameters& Parameters)
+{
+	// The material opt-in bit is introduced by Patch 50.
+	return Parameters.MaterialParameters.bIsUsedWithSoftwareRTCapture;
+}
+
+void FSoftwareRTCaptureVertexFactory::InitRHI()
+{
+	check(VertexBuffer);
+	check(VertexBuffer->IsInitialized());
+	check(Streams.Num() == 0);
+
+	FVertexStream Stream;
+	Stream.VertexBuffer = VertexBuffer;
+	Stream.Stride = sizeof(FSoftwareRTCaptureVertex);
+	Stream.Offset = 0;
+	Streams.Add(Stream);
+
+	FVertexDeclarationElementList Elements;
+	Elements.Add(FVertexElement(0, STRUCT_OFFSET(FSoftwareRTCaptureVertex, Position), VET_Float4, 0, sizeof(FSoftwareRTCaptureVertex)));
+	Elements.Add(FVertexElement(0, STRUCT_OFFSET(FSoftwareRTCaptureVertex, TangentX), VET_Float4, 1, sizeof(FSoftwareRTCaptureVertex)));
+	Elements.Add(FVertexElement(0, STRUCT_OFFSET(FSoftwareRTCaptureVertex, TangentZ), VET_Float4, 2, sizeof(FSoftwareRTCaptureVertex)));
+
+	for (uint8 TexCoordIndex = 0; TexCoordIndex < 4; ++TexCoordIndex)
+	{
+		Elements.Add(FVertexElement(
+			0,
+			STRUCT_OFFSET(FSoftwareRTCaptureVertex, TexCoords) + TexCoordIndex * sizeof(FVector2D),
+			VET_Float2,
+			3 + TexCoordIndex,
+			sizeof(FSoftwareRTCaptureVertex)));
+	}
+
+	Elements.Add(FVertexElement(0, STRUCT_OFFSET(FSoftwareRTCaptureVertex, ChartPosition), VET_Float4, 7, sizeof(FSoftwareRTCaptureVertex)));
+	Elements.Add(FVertexElement(0, STRUCT_OFFSET(FSoftwareRTCaptureVertex, Color), VET_Color, 8, sizeof(FSoftwareRTCaptureVertex)));
+
+	InitDeclaration(Elements);
+	check(IsValidRef(GetDeclaration()));
+}
+
+IMPLEMENT_VERTEX_FACTORY_TYPE_EX(
+	FSoftwareRTCaptureVertexFactory,
+	"/Engine/Private/SoftwareRTCaptureVertexFactory.ush",
+	true, false, false, false, false, false, false);
+
+void FSoftwareRTCaptureVertexBuffer::SetVertices_RenderThread(
+	const TArray<FSoftwareRTCaptureVertex>& InVertices)
+{
+	check(IsInRenderingThread());
+	check(!IsInitialized());
+	check(InVertices.Num() > 0);
+	check((InVertices.Num() % 3) == 0);
+
+	Vertices = InVertices;
+}
+
+void FSoftwareRTCaptureVertexBuffer::InitRHI()
+{
+	check(IsInRenderingThread());
+	check(Vertices.Num() > 0);
+	check((Vertices.Num() % 3) == 0);
+
+	const uint32 BufferSize = Vertices.Num() * sizeof(FSoftwareRTCaptureVertex);
+	FRHIResourceCreateInfo CreateInfo;
+	void* BufferData = nullptr;
+
+	VertexBufferRHI = RHICreateAndLockVertexBuffer(
+		BufferSize,
+		BUF_Static,
+		CreateInfo,
+		BufferData);
+
+	check(BufferData);
+	FMemory::Memcpy(BufferData, Vertices.GetData(), BufferSize);
+	RHIUnlockVertexBuffer(VertexBufferRHI);
+}
