+		ECVF_RenderThreadSafe);
+
+	static TRefCountPtr<IPooledRenderTarget> GSoftwareRTCaptureBaseColorRoughness;
+	static TRefCountPtr<IPooledRenderTarget> GSoftwareRTCaptureWorldNormalMetallic;
+	static TRefCountPtr<IPooledRenderTarget> GSoftwareRTCaptureEmissiveSpecular;
+
+	struct FSoftwareRTCaptureRetiredDrawItems
+	{
+		FGraphEventRef Fence;
+		TArray<TSharedPtr<FSoftwareRTCaptureDrawItem>> Owners;
+	};
+
+	static TArray<FSoftwareRTCaptureRetiredDrawItems> GSoftwareRTCaptureRetiredDrawItems;
+
+	bool IsSoftwareRTMaterialCaptureEnabled()
+	{
+		return CVarSoftwareRTMaterialCapture.GetValueOnRenderThread() != 0;
+	}
+
+	const TRefCountPtr<IPooledRenderTarget>& GetSoftwareRTCaptureBaseColorRoughness()
+	{
+		return GSoftwareRTCaptureBaseColorRoughness;
+	}
+
+	const TRefCountPtr<IPooledRenderTarget>& GetSoftwareRTCaptureWorldNormalMetallic()
+	{
+		return GSoftwareRTCaptureWorldNormalMetallic;
+	}
+
+	const TRefCountPtr<IPooledRenderTarget>& GetSoftwareRTCaptureEmissiveSpecular()
+	{
+		return GSoftwareRTCaptureEmissiveSpecular;
+	}
+
+	void CollectRetiredSoftwareRTCaptureDrawItems_RenderThread()
+	{
+		check(IsInRenderingThread());
+		for (int32 Index = GSoftwareRTCaptureRetiredDrawItems.Num() - 1; Index >= 0; --Index)
+		{
+			FSoftwareRTCaptureRetiredDrawItems& Retired = GSoftwareRTCaptureRetiredDrawItems[Index];
+			if (!IsValidRef(Retired.Fence) || Retired.Fence->IsComplete())
+			{
+				Retired.Owners.Reset();
+				GSoftwareRTCaptureRetiredDrawItems.RemoveAtSwap(Index, 1, false);
+			}
+		}
+	}
+
+	void RetireSoftwareRTCaptureDrawItems_RenderThread(
+		FRHICommandListImmediate& RHICmdList,
+		TArray<TSharedPtr<FSoftwareRTCaptureDrawItem>>&& Owners)
+	{
+		check(IsInRenderingThread());
+		if (Owners.Num() == 0)
+		{
+			return;
+		}
+
+		FGraphEventRef Fence = RHICmdList.RHIThreadFence();
+		RHICmdList.ImmediateFlush(EImmediateFlushType::DispatchToRHIThread);
+		if (!IsValidRef(Fence))
+		{
+			Owners.Reset();
+			return;
+		}
+
+		FSoftwareRTCaptureRetiredDrawItems& Retired = GSoftwareRTCaptureRetiredDrawItems.AddDefaulted_GetRef();
+		Retired.Fence = Fence;
+		Retired.Owners = MoveTemp(Owners);
+	}
