@@ -107,6 +108,27 @@
 		Retired.Owners = MoveTemp(Owners);
 	}
 
+
+	void ShutdownSoftwareRTMaterialCapture_RenderThread(FRHICommandListImmediate& RHICmdList)
+	{
+		check(IsInRenderingThread());
+
+		for (FSoftwareRTCaptureRetiredDrawItems& Retired : GSoftwareRTCaptureRetiredDrawItems)
+		{
+			if (IsValidRef(Retired.Fence))
+			{
+				FRHICommandListExecutor::WaitOnRHIThreadFence(Retired.Fence);
+			}
+			Retired.Owners.Reset();
+		}
+		GSoftwareRTCaptureRetiredDrawItems.Reset();
+
+		GSoftwareRTCaptureBaseColorRoughness = nullptr;
+		GSoftwareRTCaptureWorldNormalMetallic = nullptr;
+		GSoftwareRTCaptureEmissiveSpecular = nullptr;
+		GSoftwareRTCaptureTriangleMetadata.Reset();
+	}
+
