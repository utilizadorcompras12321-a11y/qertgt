 #include "SoftwareRTCaptureVertexFactory.h"
 #include "SoftwareRTMaterialCapture.h"
 
@@ -13,3 +15,7 @@
 namespace SoftwareRTMaterialCapture
 {
+	BEGIN_SHADER_PARAMETER_STRUCT(FSoftwareRTMaterialCapturePassParameters, )
+		RENDER_TARGET_BINDING_SLOTS()
+	END_SHADER_PARAMETER_STRUCT()
+
 	static bool ShouldCompile(const FMeshMaterialShaderPermutationParameters& Parameters)
@@ -241,1 +247,64 @@
+	FSoftwareRTMaterialCaptureOutputs AddSoftwareRTMaterialCapturePass(
+		FRDGBuilder& GraphBuilder,
+		const FScene* Scene,
+		const FSceneView& View,
+		const TArray<const FMeshBatch*>& MeshBatches,
+		FIntPoint AtlasExtent)
+	{
+		check(Scene);
+		check(AtlasExtent.X > 0 && AtlasExtent.Y > 0);
+
+		const FRDGTextureDesc CaptureDesc = FRDGTextureDesc::Create2D(
+			AtlasExtent,
+			PF_FloatRGBA,
+			FClearValueBinding::Black,
+			TexCreate_RenderTargetable | TexCreate_ShaderResource);
+
+		FSoftwareRTMaterialCaptureOutputs Outputs;
+		Outputs.BaseColorRoughness = GraphBuilder.CreateTexture(CaptureDesc, TEXT("SoftwareRT.BaseColorRoughness"));
+		Outputs.WorldNormalMetallic = GraphBuilder.CreateTexture(CaptureDesc, TEXT("SoftwareRT.WorldNormalMetallic"));
+		Outputs.EmissiveSpecular = GraphBuilder.CreateTexture(CaptureDesc, TEXT("SoftwareRT.EmissiveSpecular"));
+
+		FSoftwareRTMaterialCapturePassParameters* PassParameters =
+			GraphBuilder.AllocParameters<FSoftwareRTMaterialCapturePassParameters>();
+		PassParameters->RenderTargets[0] = FRenderTargetBinding(
+			Outputs.BaseColorRoughness,
+			ERenderTargetLoadAction::EClear);
+		PassParameters->RenderTargets[1] = FRenderTargetBinding(
+			Outputs.WorldNormalMetallic,
+			ERenderTargetLoadAction::EClear);
+		PassParameters->RenderTargets[2] = FRenderTargetBinding(
+			Outputs.EmissiveSpecular,
+			ERenderTargetLoadAction::EClear);
+
+		// The caller retains every pointed-to batch and its resources through
+		// graph execution and subsequent RHI retirement.
+		const TArray<const FMeshBatch*> MeshBatchesCopy = MeshBatches;
+
+		GraphBuilder.AddPass(
+			RDG_EVENT_NAME("SoftwareRTMaterialCapture"),
+			PassParameters,
+			ERDGPassFlags::Raster,
+			[Scene, &View, MeshBatchesCopy, AtlasExtent](FRHICommandListImmediate& RHICmdList)
+		{
+			RHICmdList.SetViewport(0.0f, 0.0f, 0.0f, float(AtlasExtent.X), float(AtlasExtent.Y), 1.0f);
+			RHICmdList.SetScissorRect(false, 0, 0, 0, 0);
+
+			DrawDynamicMeshPass(
+				View,
+				RHICmdList,
+				[Scene, &View, &MeshBatchesCopy](FMeshPassDrawListContext* DrawListContext)
+				{
+					FSoftwareRTMaterialCaptureMeshProcessor Processor(Scene, View, DrawListContext);
+					for (const FMeshBatch* MeshBatch : MeshBatchesCopy)
+					{
+						if (MeshBatch)
+						{
+							Processor.AddMeshBatch(*MeshBatch, ~uint64(0), nullptr, -1);
+						}
+					}
+				},
+				true);
+		});
+		return Outputs;
+	}
 }
