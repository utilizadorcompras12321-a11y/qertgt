+++ b/Engine/Source/Runtime/Engine/Private/SoftwareRTCaptureVertexFactory.cpp
@@ -1,29 +1,88 @@
 // Copyright Epic Games, Inc. All Rights Reserved.
 
 #include "SoftwareRTCaptureVertexFactory.h"
+#include "MaterialShared.h"
 
-/**
- * No VF-specific bindings are required by the inert registration stub.
- * The real capture ABI will add its own stream and uniform parameters.
- */
+// No additional uniform parameters are required: all capture attributes are
+// carried by the expanded vertex stream.
 class FSoftwareRTCaptureVertexFactoryShaderParameters : public FVertexFactoryShaderParameters
 {
 	DECLARE_INLINE_TYPE_LAYOUT(FSoftwareRTCaptureVertexFactoryShaderParameters, NonVirtual);
 };
 
 IMPLEMENT_VERTEX_FACTORY_PARAMETER_TYPE(
 	FSoftwareRTCaptureVertexFactory,
 	SF_Vertex,
 	FSoftwareRTCaptureVertexFactoryShaderParameters);
 
+void FSoftwareRTCaptureVertexFactory::SetData(const FVertexBuffer* InVertexBuffer)
+{
+	check(IsInRenderingThread());
+	check(InVertexBuffer);
+	check(InVertexBuffer->IsInitialized());
+
+	VertexBuffer = InVertexBuffer;
+	UpdateRHI();
+}
+
 bool FSoftwareRTCaptureVertexFactory::ShouldCompilePermutation(
 	const FVertexFactoryShaderPermutationParameters& Parameters)
 {
-	// Keep the type registered but prevent material permutations until the ABI exists.
-	return false;
+	// The material opt-in bit is introduced by Patch 50.
+	return Parameters.MaterialParameters.bIsUsedWithSoftwareRTCapture;
 }
 
 void FSoftwareRTCaptureVertexFactory::InitRHI()
 {
-	// Intentionally empty: this stub has no vertex declaration or streams.
+	check(VertexBuffer);
+	check(VertexBuffer->IsInitialized());
+	check(Streams.Num() == 0);
+
+	FVertexStream Stream;
+	Stream.VertexBuffer = VertexBuffer;
+	Stream.Stride = sizeof(FSoftwareRTCaptureVertex);
+	Stream.Offset = 0;
+	Streams.Add(Stream);
+
+	FVertexDeclarationElementList Elements;
+	Elements.Add(FVertexElement(0, STRUCT_OFFSET(FSoftwareRTCaptureVertex, Position), VET_Float4, 0, sizeof(FSoftwareRTCaptureVertex)));
+	Elements.Add(FVertexElement(0, STRUCT_OFFSET(FSoftwareRTCaptureVertex, TangentX), VET_Float4, 1, sizeof(FSoftwareRTCaptureVertex)));
+	Elements.Add(FVertexElement(0, STRUCT_OFFSET(FSoftwareRTCaptureVertex, TangentZ), VET_Float4, 2, sizeof(FSoftwareRTCaptureVertex)));
+
+	for (uint8 TexCoordIndex = 0; TexCoordIndex < 4; ++TexCoordIndex)
+	{
+		Elements.Add(FVertexElement(
+			0,
+			STRUCT_OFFSET(FSoftwareRTCaptureVertex, TexCoords) + TexCoordIndex * sizeof(FVector2D),
+			VET_Float2,
+			3 + TexCoordIndex,
+			sizeof(FSoftwareRTCaptureVertex)));
+	}
+
+	Elements.Add(FVertexElement(0, STRUCT_OFFSET(FSoftwareRTCaptureVertex, ChartPosition), VET_Float4, 7, sizeof(FSoftwareRTCaptureVertex)));
+	Elements.Add(FVertexElement(0, STRUCT_OFFSET(FSoftwareRTCaptureVertex, Color), VET_Color, 8, sizeof(FSoftwareRTCaptureVertex)));
+
+	InitDeclaration(Elements);
+	check(IsValidRef(GetDeclaration()));
 }
 
 IMPLEMENT_VERTEX_FACTORY_TYPE_EX(
 	FSoftwareRTCaptureVertexFactory,
 	"/Engine/Private/SoftwareRTCaptureVertexFactory.ush",
 	true, false, false, false, false, false, false);
diff --git a/Engine/Shaders/Private/SoftwareRTCaptureVertexFactory.ush b/Engine/Shaders/Private/SoftwareRTCaptureVertexFactory.ush
index 3333333..6666666 100644
--- a/Engine/Shaders/Private/SoftwareRTCaptureVertexFactory.ush
+++ b/Engine/Shaders/Private/SoftwareRTCaptureVertexFactory.ush
@@ -1,4 +1,211 @@
 // Copyright Epic Games, Inc. All Rights Reserved.
 
-// Deliberately empty while the C++ vertex factory remains an inert registration stub.
-// Add the vertex-factory shader ABI only when its input streams are implemented.
+#include "VertexFactoryCommon.ush"
+
+// Attribute layout must match FSoftwareRTCaptureVertex in
+// SoftwareRTCaptureVertexFactory.h exactly.
+struct FVertexFactoryInput
+{
+	float4 Position       : ATTRIBUTE0;
+	float4 TangentX       : ATTRIBUTE1;
+	float4 TangentZ       : ATTRIBUTE2;
+	float2 TexCoords[4]   : ATTRIBUTE3;
+	float4 ChartPosition  : ATTRIBUTE7;
+	float4 Color          : ATTRIBUTE8;
+	uint InstanceId       : SV_InstanceID;
+};
+
+struct FVertexFactoryIntermediates
+{
+	float3 LocalPosition;
+	float3x3 TangentToLocal;
+	float3x3 TangentToWorld;
+	float4 Color;
+};
+
+struct FVertexFactoryInterpolantsVSToPS
+{
+#if INTERPOLATE_VERTEX_COLOR
+	float4 Color : COLOR0;
+#endif
+#if NUM_TEX_COORD_INTERPOLATORS
+	float2 TexCoords[NUM_TEX_COORD_INTERPOLATORS] : TEXCOORD0;
+#endif
+	TANGENTTOWORLD_INTERPOLATOR_BLOCK
+#if INSTANCED_STEREO
+	nointerpolation uint EyeIndex : PACKED_EYE_INDEX;
+#endif
+};
+
+float4 SoftwareRTGetChartClipPosition(FVertexFactoryInput Input)
+{
+	return Input.ChartPosition;
+}
+
+half3x3 SoftwareRTCalcTangentToLocal(FVertexFactoryInput Input)
+{
+	half3 TangentX = normalize((half3)Input.TangentX.xyz);
+	half4 TangentZ = (half4)Input.TangentZ;
+	TangentZ.xyz = normalize(TangentZ.xyz);
+	half3 TangentY = normalize(cross(TangentZ.xyz, TangentX)) * TangentZ.w;
+
+	half3x3 Result;
+	Result[0] = normalize(cross(TangentY, TangentZ.xyz)) * TangentZ.w;
+	Result[1] = TangentY;
+	Result[2] = TangentZ.xyz;
+	return Result;
+}
+
+FVertexFactoryIntermediates GetVertexFactoryIntermediates(FVertexFactoryInput Input)
+{
+	FVertexFactoryIntermediates Result;
+	Result.LocalPosition = Input.Position.xyz;
+	Result.TangentToLocal = SoftwareRTCalcTangentToLocal(Input);
+
+	float3x3 LocalToWorld = GetLocalToWorld3x3();
+	half3 InvScale = Primitive.InvNonUniformScaleAndDeterminantSign.xyz;
+	LocalToWorld[0] *= InvScale.x;
+	LocalToWorld[1] *= InvScale.y;
+	LocalToWorld[2] *= InvScale.z;
+
+	Result.TangentToWorld = mul(Result.TangentToLocal, LocalToWorld);
+	Result.Color = Input.Color;
+	return Result;
+}
+
+float4 VertexFactoryGetWorldPosition(FVertexFactoryInput Input, FVertexFactoryIntermediates Intermediates)
+{
+	return TransformLocalToTranslatedWorld(Intermediates.LocalPosition);
+}
+
+// The normal material vertex path remains in original world space. The
+// dedicated capture VS uses SoftwareRTGetChartClipPosition() for SV_POSITION.
+float4 VertexFactoryGetRasterizedWorldPosition(FVertexFactoryInput Input, FVertexFactoryIntermediates Intermediates, float4 TranslatedWorldPosition)
+{
+	return TranslatedWorldPosition;
+}
+
+float3 VertexFactoryGetPositionForVertexLighting(FVertexFactoryInput Input, FVertexFactoryIntermediates Intermediates, float3 TranslatedWorldPosition)
+{
+	return TranslatedWorldPosition;
+}
+
+float3x3 VertexFactoryGetTangentToLocal(FVertexFactoryInput Input, FVertexFactoryIntermediates Intermediates)
+{
+	return Intermediates.TangentToLocal;
+}
+
+float3 VertexFactoryGetWorldNormal(FVertexFactoryInput Input, FVertexFactoryIntermediates Intermediates)
+{
+	return normalize(Intermediates.TangentToWorld[2]);
+}
+
+FMaterialVertexParameters GetMaterialVertexParameters(FVertexFactoryInput Input, FVertexFactoryIntermediates Intermediates, float3 WorldPosition, float3x3 TangentToLocal)
+{
+	FMaterialVertexParameters Result = (FMaterialVertexParameters)0;
+	Result.WorldPosition = WorldPosition;
+	Result.VertexColor = Intermediates.Color;
+	Result.TangentToWorld = Intermediates.TangentToWorld;
+	Result.PreSkinnedPosition = Intermediates.LocalPosition;
+
+#if NUM_MATERIAL_TEXCOORDS_VERTEX
+	UNROLL
+	for (int CoordinateIndex = 0; CoordinateIndex < NUM_MATERIAL_TEXCOORDS_VERTEX; ++CoordinateIndex)
+	{
+		Result.TexCoords[CoordinateIndex] = Input.TexCoords[min(CoordinateIndex, 3)];
+	}
+#endif
+	return Result;
+}
+
+void SoftwareRTCalcTangentToWorld(FVertexFactoryInput Input, FVertexFactoryIntermediates Intermediates, out float3 TangentToWorld0, out float4 TangentToWorld2)
+{
+	TangentToWorld0 = Intermediates.TangentToWorld[0];
+	TangentToWorld2 = float4(
+		Intermediates.TangentToWorld[2],
+		Input.TangentZ.w * Primitive.InvNonUniformScaleAndDeterminantSign.w);
+}
+
+FVertexFactoryInterpolantsVSToPS VertexFactoryGetInterpolantsVSToPS(FVertexFactoryInput Input, FVertexFactoryIntermediates Intermediates, FMaterialVertexParameters VertexParameters)
+{
+	FVertexFactoryInterpolantsVSToPS Result;
+
+#if NUM_TEX_COORD_INTERPOLATORS
+	UNROLL
+	for (int CoordinateIndex = 0; CoordinateIndex < NUM_TEX_COORD_INTERPOLATORS; ++CoordinateIndex)
+	{
+		Result.TexCoords[CoordinateIndex] = Input.TexCoords[min(CoordinateIndex, 3)];
+	}
+#endif
+
+#if INTERPOLATE_VERTEX_COLOR
+	Result.Color = Intermediates.Color;
+#endif
+
+	float3 TangentToWorld0;
+	float4 TangentToWorld2;
+	SoftwareRTCalcTangentToWorld(Input, Intermediates, TangentToWorld0, TangentToWorld2);
+	// These names are provided by TANGENTTOWORLD_INTERPOLATOR_BLOCK.
+	Result.TangentToWorld0 = float4(TangentToWorld0, 0);
+	Result.TangentToWorld2 = TangentToWorld2;
+
+#if INSTANCED_STEREO
+	Result.EyeIndex = 0;
+#endif
+	return Result;
+}
+
+FMaterialPixelParameters GetMaterialPixelParameters(FVertexFactoryInterpolantsVSToPS Interpolants, float4 SvPosition)
+{
+	FMaterialPixelParameters Result = MakeInitializedMaterialPixelParameters();
+
+#if NUM_TEX_COORD_INTERPOLATORS
+	UNROLL
+	for (int CoordinateIndex = 0; CoordinateIndex < NUM_TEX_COORD_INTERPOLATORS; ++CoordinateIndex)
+	{
+		Result.TexCoords[CoordinateIndex] = Interpolants.TexCoords[CoordinateIndex];
+	}
+#endif
+
+#if INTERPOLATE_VERTEX_COLOR
+	Result.VertexColor = Interpolants.Color;
+#else
+	Result.VertexColor = 0;
+#endif
+
+	Result.TangentToWorld = AssembleTangentToWorld(Interpolants.TangentToWorld0.xyz, Interpolants.TangentToWorld2);
+	Result.UnMirrored = Interpolants.TangentToWorld2.w;
+	Result.TwoSidedSign = 1;
+	return Result;
+}
+
+float4 VertexFactoryGetPreviousWorldPosition(FVertexFactoryInput Input, FVertexFactoryIntermediates Intermediates)
+{
+	return VertexFactoryGetWorldPosition(Input, Intermediates);
+}
+
+float4 VertexFactoryGetTranslatedPrimitiveVolumeBounds(FVertexFactoryInterpolantsVSToPS Interpolants)
+{
+	return 0;
+}
+
+#if INSTANCED_STEREO
+uint VertexFactoryGetEyeIndex(uint InstanceId)
+{
+	return 0;
+}
+#endif
