 // Copyright Epic Games, Inc. All Rights Reserved.
 
 #pragma once
 
+#include "CoreMinimal.h"
 #include "VertexFactory.h"
 
 /**
- * Initial, inert registration stub for the Software RT capture vertex factory.
- * It must not be used for drawing until its vertex streams and declaration exist.
+ * Expanded per-triangle vertex layout used by Software RT chart capture.
+ *
+ * Position/Tangent/UV/Color remain in the original mesh domain.
+ * ChartPosition is an independent clip-space position used only by the
+ * dedicated capture vertex shader. It must not replace Position when
+ * evaluating the original material.
  */
+struct FSoftwareRTCaptureVertex
+{
+	FVector4 Position;
+	FVector4 TangentX;
+	FVector4 TangentZ;
+	FVector2D TexCoords[4];
+	FVector4 ChartPosition;
+	FColor Color;
+};
+
 class ENGINE_API FSoftwareRTCaptureVertexFactory : public FVertexFactory
 {
 	DECLARE_VERTEX_FACTORY_TYPE(FSoftwareRTCaptureVertexFactory);
 
 public:
 	explicit FSoftwareRTCaptureVertexFactory(ERHIFeatureLevel::Type InFeatureLevel)
 		: FVertexFactory(InFeatureLevel)
 	{
 	}
 
+	/**
+	 * Set the expanded capture vertex buffer.
+	 * The caller owns the buffer and must retain it until this VF has been
+	 * released and all submitted draw commands have retired.
+	 * Must be called on the render thread.
+	 */
+	void SetData(const FVertexBuffer* InVertexBuffer);
+
 	static bool ShouldCompilePermutation(const FVertexFactoryShaderPermutationParameters& Parameters);
 
 	virtual void InitRHI() override;
+
+private:
+	const FVertexBuffer* VertexBuffer = nullptr;
 };
