+// Copyright Epic Games, Inc. All Rights Reserved.
+
+#include "MaterialShared.h"
+#include "MaterialShader.h"
+#include "MeshMaterialShader.h"
+#include "SoftwareRTCaptureVertexFactory.h"
+
+namespace SoftwareRTMaterialCapture
+{
+	static bool ShouldCompile(const FMeshMaterialShaderPermutationParameters& Parameters)
+	{
+		const FMaterialShaderParameters& Material = Parameters.MaterialParameters;
+
+		return Material.bIsUsedWithSoftwareRTCapture
+			&& Material.MaterialDomain == MD_Surface
+			&& Material.BlendMode == BLEND_Opaque
+			&& Material.TessellationMode == MTM_NoTessellation
+			&& !Material.bHasVertexPositionOffsetConnected
+			&& !Material.bHasPixelDepthOffsetConnected
+			&& !Material.bMaterialMayModifyMeshPosition
+			&& Parameters.VertexFactoryType == &FSoftwareRTCaptureVertexFactory::StaticType
+			&& FMeshMaterialShader::ShouldCompilePermutation(Parameters);
+	}
+
+	class FSoftwareRTMaterialCaptureVS : public FMeshMaterialShader
+	{
+	public:
+		DECLARE_SHADER_TYPE(FSoftwareRTMaterialCaptureVS, MeshMaterial);
+
+		static bool ShouldCompilePermutation(const FMeshMaterialShaderPermutationParameters& Parameters)
+		{
+			return SoftwareRTMaterialCapture::ShouldCompile(Parameters);
+		}
+
+		static void ModifyCompilationEnvironment(
+			const FMaterialShaderPermutationParameters& Parameters,
+			FShaderCompilerEnvironment& OutEnvironment)
+		{
+			FMeshMaterialShader::ModifyCompilationEnvironment(Parameters, OutEnvironment);
+			OutEnvironment.SetDefine(TEXT("SOFTWARE_RT_MATERIAL_CAPTURE"), 1);
+		}
+
+		FSoftwareRTMaterialCaptureVS() = default;
+		FSoftwareRTMaterialCaptureVS(const ShaderMetaType::CompiledShaderInitializerType& Initializer)
+			: FMeshMaterialShader(Initializer)
+		{
+		}
+	};
+
+	class FSoftwareRTMaterialCapturePS : public FMeshMaterialShader
+	{
+	public:
+		DECLARE_SHADER_TYPE(FSoftwareRTMaterialCapturePS, MeshMaterial);
+
+		static bool ShouldCompilePermutation(const FMeshMaterialShaderPermutationParameters& Parameters)
+		{
+			return SoftwareRTMaterialCapture::ShouldCompile(Parameters);
+		}
+
+		static void ModifyCompilationEnvironment(
+			const FMaterialShaderPermutationParameters& Parameters,
+			FShaderCompilerEnvironment& OutEnvironment)
+		{
+			FMeshMaterialShader::ModifyCompilationEnvironment(Parameters, OutEnvironment);
+			OutEnvironment.SetDefine(TEXT("SOFTWARE_RT_MATERIAL_CAPTURE"), 1);
+			OutEnvironment.SetRenderTargetOutputFormat(0, PF_FloatRGBA);
+			OutEnvironment.SetRenderTargetOutputFormat(1, PF_FloatRGBA);
+			OutEnvironment.SetRenderTargetOutputFormat(2, PF_FloatRGBA);
+		}
+
+		FSoftwareRTMaterialCapturePS() = default;
+		FSoftwareRTMaterialCapturePS(const ShaderMetaType::CompiledShaderInitializerType& Initializer)
+			: FMeshMaterialShader(Initializer)
+		{
+		}
+	};
+
+	IMPLEMENT_MATERIAL_SHADER_TYPE(
+		,
+		FSoftwareRTMaterialCaptureVS,
+		TEXT("/Engine/Private/SoftwareRTMaterialCapture.usf"),
+		TEXT("MainVS"),
+		SF_Vertex);
+
+	IMPLEMENT_MATERIAL_SHADER_TYPE(
+		,
+		FSoftwareRTMaterialCapturePS,
+		TEXT("/Engine/Private/SoftwareRTMaterialCapture.usf"),
+		TEXT("MainPS"),
+		SF_Pixel);
+}
