+// Copyright Epic Games, Inc. All Rights Reserved.
+
+// Material evaluation for the Software RT Surface Cache.
+// SV_POSITION is chart/atlas space. Original translated world position and
+// material interpolants travel independently and are used for material inputs.
+
+#include "Common.ush"
+#include "/Engine/Generated/Material.ush"
+#include "/Engine/Generated/VertexFactory.ush"
+
+struct FSoftwareRTCaptureVSOutput
+{
+	FVertexFactoryInterpolantsVSToPS FactoryInterpolants;
+	float4 Position : SV_POSITION;
+};
+
+FSoftwareRTCaptureVSOutput MainVS(FVertexFactoryInput Input)
+{
+	FSoftwareRTCaptureVSOutput Output;
+
+	FVertexFactoryIntermediates VFIntermediates = GetVertexFactoryIntermediates(Input);
+	float4 WorldPosition = VertexFactoryGetWorldPosition(Input, VFIntermediates);
+	float3x3 TangentToLocal = VertexFactoryGetTangentToLocal(Input, VFIntermediates);
+	FMaterialVertexParameters VertexParameters = GetMaterialVertexParameters(
+		Input,
+		VFIntermediates,
+		WorldPosition.xyz,
+		TangentToLocal);
+
+	Output.Position = SoftwareRTGetChartClipPosition(Input);
+	Output.FactoryInterpolants = VertexFactoryGetInterpolantsVSToPS(
+		Input,
+		VFIntermediates,
+		VertexParameters);
+
+	return Output;
+}
+
+void FPixelShaderInOut_MainPS(
+	in FVertexFactoryInterpolantsVSToPS Interpolants,
+	inout FPixelShaderIn In,
+	inout FPixelShaderOut Out)
+{
+	ResolvedView = ResolveView();
+
+	FMaterialPixelParameters MaterialParameters = GetMaterialPixelParameters(
+		Interpolants,
+		In.SvPosition);
+
+	FPixelMaterialInputs PixelMaterialInputs;
+	const float4 ChartScreenPosition = 0;
+	const float3 TranslatedWorldPosition = Interpolants.TranslatedWorldPosition;
+	CalcMaterialParametersEx(
+		MaterialParameters,
+		PixelMaterialInputs,
+		In.SvPosition,
+		ChartScreenPosition,
+		In.bIsFrontFace,
+		TranslatedWorldPosition,
+		TranslatedWorldPosition);
+
+	const half3 BaseColor = GetMaterialBaseColor(PixelMaterialInputs);
+	const half Roughness = GetMaterialRoughness(PixelMaterialInputs);
+	const half Metallic = GetMaterialMetallic(PixelMaterialInputs);
+	const half Specular = GetMaterialSpecular(PixelMaterialInputs);
+	const half3 Emissive = GetMaterialEmissive(PixelMaterialInputs);
+	const float3 WorldNormal = normalize(MaterialParameters.WorldNormal);
+
+	Out.MRT[0] = float4(BaseColor, Roughness);
+	Out.MRT[1] = float4(WorldNormal * 0.5f + 0.5f, Metallic);
+	Out.MRT[2] = float4(Emissive, Specular);
+}
+
+#define PIXELSHADEROUTPUT_INTERPOLANTS 1
+#define PIXELSHADEROUTPUT_MRT0 1
+#define PIXELSHADEROUTPUT_MRT1 1
+#define PIXELSHADEROUTPUT_MRT2 1
+
+#include "PixelShaderOutputCommon.ush"
